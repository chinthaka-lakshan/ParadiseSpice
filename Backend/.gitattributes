# Auto detect text files and perform LF normalization
* text=auto

# These files are text and should be normalized
*.php text
*.blade.php text diff=html
*.js text
*.json text
*.css text diff=css
*.scss text
*.html text diff=html
*.md text diff=markdown
*.yml text
*.yaml text
*.xml text
*.txt text
*.sql text
*.env text
*.env.example text

# These files are binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.svg binary
*.svgz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.zip binary
*.tar.gz binary
*.rar binary

# Laravel specific
*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Vendor directories - EXCLUDE THEM FROM LINE ENDING CHANGES
/vendor/** -text
/vendor/** linguist-vendored
/vendor/** export-ignore
/vendor/* -diff

# Composer files
composer.json text
composer.lock text
package.json text
package-lock.json text

# Development files - ignore in exports
/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
phpunit.xml export-ignore
README.md export-ignore
LICENSE export-ignore

# Git files
.gitattributes export-ignore
.gitignore export-ignore
.gitmodules export-ignore

# IDE files
.idea/ export-ignore
.vscode/ export-ignore
*.code-workspace export-ignore

# Laravel specific ignores
storage/ export-ignore
bootstrap/cache/ export-ignore
.env.example export-ignore
.env.testing export-ignore